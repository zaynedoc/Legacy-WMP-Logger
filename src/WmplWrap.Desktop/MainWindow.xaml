<Window x:Class="WmplWrap.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WMPL Wrap" Icon="/Assets/wmpl_recap_icon_header.ico" Width="1160" Height="760" MinWidth="920" MinHeight="600"
        Background="{StaticResource Brush.AppBackground}" FontFamily="{StaticResource Font.Body}">
  <Window.Resources>
    <DataTemplate x:Key="SongRow">
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" />
        <Border Grid.Column="1" Width="40" Height="40" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border>
        <StackPanel Grid.Column="2" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ArtistAlbum}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding CountLabel}" Foreground="{StaticResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AggregateRow">
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border>
        <StackPanel Grid.Column="1" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Foreground="{StaticResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SnapshotChangeTrack">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border>
        <StackPanel Grid.Column="1" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="25" /></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource NavigationButton}" Content="&#x2190;" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back" />
        <Button Grid.Column="1" Style="{StaticResource NavigationButton}" Content="&#x2192;" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward" />
        <TextBlock Grid.Column="3" Text="{Binding Breadcrumbs}" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Brush.Rail}">
        <StackPanel Margin="10,18,10,0" HorizontalAlignment="Stretch">
          <TextBlock Text="LIBRARY" Foreground="{StaticResource Brush.RailText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,7" />
          <Button Style="{StaticResource RailButton}" Content="Overview" Command="{Binding NavigateCommand}" CommandParameter="Overview" />
          <Button Style="{StaticResource RailButton}" Content="Latest snapshot" Command="{Binding NavigateCommand}" CommandParameter="LatestSnapshot" />
          <Button Style="{StaticResource RailButton}" Content="Graphs" Command="{Binding NavigateCommand}" CommandParameter="Graphs" />
          <TextBlock Text="DATA" Foreground="{StaticResource Brush.RailText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Margin="10,18,0,7" />
          <Button Style="{StaticResource RailButton}" Content="Top songs" Command="{Binding NavigateCommand}" CommandParameter="Data:Tracks" />
          <Button Style="{StaticResource RailButton}" Content="Top albums" Command="{Binding NavigateCommand}" CommandParameter="Data:Albums" />
          <Button Style="{StaticResource RailButton}" Content="Top artists" Command="{Binding NavigateCommand}" CommandParameter="Data:Artists" />
          <TextBlock Text="MANAGE" Foreground="{StaticResource Brush.RailText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Margin="10,18,0,7" />
          <Button Style="{StaticResource RailButton}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,25,28,20" Visibility="{Binding OverviewVisibility}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Listening history" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding SnapshotSummary}" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox Width="148" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" /><Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}" Style="{StaticResource PrimaryButton}" /></StackPanel>
          </Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="LISTENS" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" /><TextBlock Text="{Binding TotalListens}" FontFamily="{StaticResource Font.Display}" FontSize="23" Foreground="{StaticResource Brush.Ink}" Margin="0,3,0,0" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" Margin="0,2,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="LISTENING TIME" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" /><TextBlock Text="{Binding TotalListeningTime}" FontFamily="{StaticResource Font.Display}" FontSize="23" Foreground="{StaticResource Brush.Ink}" Margin="0,3,0,0" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" Margin="0,2,0,0" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="TOP ARTIST" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" /><TextBlock Text="{Binding MetricTopArtist}" FontFamily="{StaticResource Font.Display}" FontSize="19" Foreground="{StaticResource Brush.Ink}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding MetricTopArtistCount}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
          </Grid>
          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Top songs" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding TopCaption}" Foreground="{StaticResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding TopTracks}" ItemTemplate="{StaticResource SongRow}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" /><TextBlock Grid.Row="2" Text="{Binding TopEmptyMessage}" Foreground="{StaticResource Brush.MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding TopTracks.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Row="4" Content="View more &#x2192;" Command="{Binding NavigateCommand}" CommandParameter="Data:Tracks" HorizontalAlignment="Left" /></Grid></Border>
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Top albums" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{StaticResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding TopAlbums}" ItemTemplate="{StaticResource AggregateRow}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" /><Button Grid.Row="4" Content="View more &#x2192;" Command="{Binding NavigateCommand}" CommandParameter="Data:Albums" HorizontalAlignment="Left" /></Grid></Border>
            <Border Grid.Column="4" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Top artists" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{StaticResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding TopArtists}" ItemTemplate="{StaticResource AggregateRow}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" /><Button Grid.Row="4" Content="View more &#x2192;" Command="{Binding NavigateCommand}" CommandParameter="Data:Artists" HorizontalAlignment="Left" /></Grid></Border>
          </Grid>
      </Grid>

      <Grid Grid.Column="1" Margin="28,25,28,20" Visibility="{Binding LatestSnapshotVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Latest snapshot" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding LatestSnapshotCaption}" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,0" /></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="RECORDED INTERVAL" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" /><TextBlock Text="{Binding LatestSnapshotSummary}" FontFamily="{StaticResource Font.Display}" FontSize="18" Foreground="{StaticResource Brush.Ink}" Margin="0,4,0,0" /></StackPanel></Border>
        <Border Grid.Row="4" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="14,0" Background="{StaticResource Brush.SurfaceMuted}" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="88" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="#" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="TRACK" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="ALBUM" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="LENGTH" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="NEW LISTENS" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="TOTAL" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /></Grid>
            <Grid Grid.Row="1"><ListBox ItemsSource="{Binding LatestSnapshotTracks}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,0,0,1" Padding="14,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="88" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource SnapshotChangeTrack}" /><TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{StaticResource Brush.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" /><TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{StaticResource Brush.MutedInk}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding ListensLabel}" Foreground="{StaticResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{Binding TotalCountLabel}" Foreground="{StaticResource Brush.MutedInk}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding LatestSnapshotEmptyMessage}" Foreground="{StaticResource Brush.MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding LatestSnapshotTracks.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding GraphsVisibility}">
        <StackPanel Margin="28,25,28,20"><TextBlock Text="Graphs" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="A visual history of listening activity" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,22" />
          <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="22"><StackPanel><TextBlock Text="Snapshot timeline" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="Charts will appear here as the snapshot history grows" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,18" /><Border Height="210" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="3"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Font.Icon}" FontSize="30" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" /><TextBlock Text="Graph view coming soon" Foreground="{StaticResource Brush.MutedInk}" Margin="0,10,0,0" /></StackPanel></Border></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" Margin="28,25,28,20" Visibility="{Binding DataVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Listening history" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding SnapshotSummary}" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox Width="148" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" /><Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}" Style="{StaticResource PrimaryButton}" /></StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Margin="18,16,18,0"><TextBlock Text="{Binding DataTitle}" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding DataCaption}" Foreground="{StaticResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
            <Grid Grid.Row="2" Margin="14,0" Background="{StaticResource Brush.SurfaceMuted}" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="#" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="ITEM" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding DataContextColumn}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="LISTENS" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /></Grid>
            <Grid Grid.Row="3"><ListBox ItemsSource="{Binding DataRows}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,0,0,1" Padding="14,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.MutedInk}" VerticalAlignment="Center" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Grid><TextBlock Grid.Column="2" Text="{Binding Context}" Foreground="{StaticResource Brush.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" /><TextBlock Grid.Column="3" Text="{Binding CountLabel}" Foreground="{StaticResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding TopEmptyMessage}" Foreground="{StaticResource Brush.MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SettingsVisibility}">
        <StackPanel Margin="28,25,28,20" MaxWidth="720"><TextBlock Text="Settings" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="Controls for local snapshot collection" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,22" />
          <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Automatic snapshots" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="{Binding SchedulerState}" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,14" /><StackPanel Orientation="Horizontal"><Button Content="Open Task Scheduler" Command="{Binding OpenSchedulerCommand}" Margin="0,0,8,0" /><Button Content="Disable automatic snapshots" Command="{Binding DisableSchedulerCommand}" Style="{StaticResource DangerButton}" /></StackPanel></StackPanel></Border>
          <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18"><StackPanel><TextBlock Text="Project" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Ink}" /><TextBlock Text="Source code and release notes" Foreground="{StaticResource Brush.MutedInk}" Margin="0,4,0,14" /><Button Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Font.Icon}" FontSize="15" Margin="0,0,7,0" /><TextBlock Text="View on GitHub" /></StackPanel></Button></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Brush.SurfaceMuted}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,1,0,0" Padding="12,0"><TextBlock Text="{Binding DataLocationLabel}" Foreground="{StaticResource Brush.MutedInk}" FontSize="11" VerticalAlignment="Center" /></Border>
  </Grid>
</Window>
